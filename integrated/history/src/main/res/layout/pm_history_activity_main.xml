<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pm_history_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/tc_ds1_canvas">
    <LinearLayout android:id="@+id/pm_history_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/tc_ds1_surface" android:paddingStart="18dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:tag="pandamonium.app.toolbar">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Minima History" android:textColor="@color/tc_ds1_accent" android:textStyle="bold" android:textSize="18sp" android:letterSpacing="0.02" />
        <TextView android:id="@+id/pm_history_syncBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_history_sync" android:textColor="@color/tc_ds1_accent" android:textSize="14sp" android:padding="6dp" android:tag="l10n:text=l10n_history_sync"  android:minHeight="48dp" android:minWidth="48dp" android:gravity="center"/>
        <TextView android:id="@+id/pm_history_menuBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⋮" android:textColor="@color/tc_ds1_text_secondary" android:textSize="20sp" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:contentDescription="@string/l10n_history_menu" android:tag="l10n:description=l10n_history_menu"  android:minHeight="48dp" android:minWidth="48dp" android:gravity="center"/>
    </LinearLayout>
    <TextView android:id="@+id/pm_history_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/tc_ds1_surface" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="10dp" android:text="@string/l10n_history_loading" android:textColor="@color/tc_ds1_text_secondary" android:textSize="12sp" android:tag="l10n:text=l10n_history_loading" />
    <LinearLayout android:id="@+id/pm_history_pairingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/tc_ds1_surface" android:padding="16dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/l10n_history_node_unavailable" android:textColor="@color/tc_ds1_accent" android:textStyle="bold" android:textSize="15sp" android:tag="l10n:text=l10n_history_node_unavailable" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/l10n_history_node_retry" android:textColor="@color/tc_ds1_text_secondary" android:textSize="13sp" android:tag="l10n:text=l10n_history_node_retry" />
        <Button android:id="@+id/pm_history_openNodeBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/l10n_history_open_core" android:tag="l10n:text=l10n_history_open_core" />
    </LinearLayout>
    <EditText android:id="@+id/pm_history_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_history_search" android:textColorHint="@color/tc_ds1_text_secondary" android:textColor="@color/tc_ds1_text" android:textSize="14sp" android:maxLines="1" android:inputType="text" android:background="@color/tc_ds1_surface" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:tag="l10n:hint=l10n_history_search" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pm_history_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
</LinearLayout>